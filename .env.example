# Copy to .env. Never commit .env.
#
# Needed only to extract invoices live or to record new model responses. The evaluation and CI
# replay recorded responses and need no key.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Demo users, created on first start. Change both before letting anyone else near the app.
PAYABLES_APPROVER_PASSWORD=choose-an-approver-password
PAYABLES_ADMIN_PASSWORD=choose-an-admin-password

# The session secret, audit key and database passwords are generated on first start by Docker
# Compose (the `secrets` volume). Outside Compose, set each one (32+ random bytes) or point the
# *_FILE variable at a file:
# PAYABLES_SESSION_SECRET_FILE=/path/to/session_secret
# PAYABLES_AUDIT_KEY_FILE=/path/to/audit_key
