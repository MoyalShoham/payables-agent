# Copy to .env. Never commit .env.
# Needed only to extract invoices live or to record new model responses. The evaluation and CI
# replay recorded responses and need no key.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Demo users created on first start (change these).
PAYABLES_APPROVER_PASSWORD=change-me-approver
PAYABLES_ADMIN_PASSWORD=change-me-admin
# Signs session cookies; any long random string.
PAYABLES_SESSION_SECRET=replace-with-a-long-random-string
